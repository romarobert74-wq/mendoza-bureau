rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isElFaro() {
      return request.auth != null && getUserData().rol == 'el_faro';
    }

    function isBureau() {
      return request.auth != null && getUserData().rol == 'bureau';
    }

    function isSocio() {
      return request.auth != null && getUserData().rol == 'socio';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuarios: cada uno ve el suyo; bureau y el_faro ven todos
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isBureau() || isElFaro()
      );
      allow create: if isElFaro();
      allow update: if isElFaro() || (isBureau() && request.auth.uid == userId);
      allow delete: if isElFaro();
    }

    // Socios: lectura pública (el tour virtual y la web institucional los leen sin login).
    // Crear: público (formulario del socio). Editar / borrar: solo roles internos.
    match /socios/{socioId} {
      allow read: if true;
      allow create: if true;
      allow update: if isElFaro() || (
        isBureau() && !(
          'urlInternaTour' in request.resource.data ||
          'urlInternaVuelta' in request.resource.data ||
          'urlDrive' in request.resource.data
        )
      );
      allow delete: if isElFaro();

      // Fotos del socio: lectura pública (galería en el tour), escritura solo interna
      match /fotos/{fotoId} {
        allow read: if true;
        allow write: if isBureau() || isElFaro();
      }
    }

    // Configuración del sistema (departamentos, categorías, tour madre, logo, etc.):
    // la mayoría es de lectura pública porque el tour y la web la necesitan sin login.
    // Los documentos SENSIBLES quedan restringidos (lista de exclusión abajo).

    // Uso del bot: lo escribe la API con Admin SDK (bypass de reglas) → nadie más escribe.
    match /configuracion/chatbot_uso {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    // Conocimiento del bot (PDFs + prompt): NO es público. La API lo lee con
    // Admin SDK; el panel lo edita con rol el_faro.
    match /configuracion/chatbot {
      allow read: if isAuthenticated();
      allow write: if isElFaro();
    }
    // Plan de migración: info interna, no la necesita el tour ni la web pública
    match /configuracion/migracion {
      allow read: if isAuthenticated();
      allow write: if isElFaro();
    }
    // Resto de la configuración: pública para lectura, EXCEPTO los sensibles de arriba.
    match /configuracion/{docId} {
      allow read: if docId != 'chatbot' && docId != 'chatbot_uso' && docId != 'migracion';
      allow write: if isElFaro();
    }

    // Web institucional pública: lectura libre, escritura solo roles internos
    match /web_bureau/{docId} {
      allow read: if true;
      allow write: if isBureau() || isElFaro();
    }
    match /web_bureau_prensa/{docId} {
      allow read: if true;
      allow write: if isBureau() || isElFaro();
    }
    match /web_bureau_observatorio/{docId} {
      allow read: if true;
      allow write: if isBureau() || isElFaro();
    }

    // Analytics / clicks: la escribe la API con Admin SDK (bypass de reglas).
    // Ya no hace falta escritura pública directa. Lectura con rol.
    match /analytics/{docId} {
      allow create: if false;
      allow read: if isAuthenticated();
      allow update, delete: if isElFaro();
    }

    // Registro de conversaciones del bot: lo escribe la API con Admin SDK.
    // Lectura solo interna (para curar el conocimiento); nadie escribe directo.
    match /chat_logs/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Copias de seguridad: solo el superadmin
    match /backups/{docId} {
      allow read, write: if isElFaro();
    }
  }
}
